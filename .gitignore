# Brainstorming visual-companion runtime session data (mockups, server-info, events).
# The committed spec docs live under docs/superpowers/specs/ and are tracked.
/.superpowers/

# Local deploy configuration (compose env interpolation) — never committed
.env

# Generated workflow packages from the build-workflows skill. Built artefacts,
# and local to whoever built them — the specs under
# .claude/skills/build-workflows/{recipes,procedures}/ are the tracked source, and
# `node lib/build.mjs` reproduces these byte for byte from them.
/examples/recipes/
/examples/procedures/

# Fetched Wikimedia Commons photographs for the build-workflows examples. 2 MB of
# third-party images that `node lib/fetch-photos.mjs` re-fetches on demand; the tracked
# artefact is photos/credits.json, which records each one's title, author, licence and
# sha256 so the cache can be re-verified with `--check`.
/.claude/skills/build-workflows/photos/*
!/.claude/skills/build-workflows/photos/credits.json
