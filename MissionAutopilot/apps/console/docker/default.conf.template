# nginx config for the Mission Autopilot console.
# Rendered at container start by the official nginx image's envsubst step,
# which fills ${ACTIONS_API_UPSTREAM} (e.g. http://mission-autopilot-server:3002).
# The API key is NOT injected here: the browser sends it (see the sign-in screen).
# nginx runtime vars ($host, $uri, $upstream) are NOT env vars, so envsubst
# leaves them untouched (it only substitutes defined env vars).

# Any other Host name (DNS rebinding, stray vhost) gets no response at all.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name localhost 127.0.0.1;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve the upstream at request time via Docker's embedded DNS instead of
    # at config load. Putting the upstream in a variable stops nginx from
    # aborting on startup ("host not found in upstream") when
    # mission-autopilot-server is not up yet, and lets it pick up a new
    # container IP after a restart.
    resolver 127.0.0.11 ipv6=off valid=10s;

    # REST API: proxy to the Mission Autopilot server. proxy_buffering off and a
    # long read timeout keep Server-Sent Events (SSE) streaming endpoints alive.
    location /trajectory/ {
        set $upstream ${ACTIONS_API_UPSTREAM};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location /management/ {
        set $upstream ${ACTIONS_API_UPSTREAM};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # SPA client-side routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # HTML must be revalidated on every load: without this a browser may reuse
    # a cached index.html from an older install and run that old bundle (e.g.
    # one that predates the sign-in screen) until the user refreshes. SPA
    # fallbacks land here too, via try_files' internal redirect to /index.html.
    location ~ \.html$ {
        add_header Cache-Control "no-cache" always;
    }

    # Vite's hashed bundles never change under the same name.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
}
