{
  "name": "mission-commander",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:help && node scripts/copy-fonts.mjs && vite",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:all": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev\"",
    "build": "npm run build:help && node scripts/copy-fonts.mjs && vite build",
    "preview": "vite preview",
    "start": "tsx src/server/index.ts",
    "seed": "tsx src/server/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "e2e": "playwright test",
    "build:help": "node scripts/build-help.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.2",
    "@tanstack/react-router": "^1.87.0",
    "better-auth": "~1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.7",
    "jsdom": "^25.0.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.468.0",
    "mission-control-db": "file:../mission-control-db",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/open-sans": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-plugin": "^1.87.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/adm-zip": "^0.5.8",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
