# Mission Designer Environment Configuration
# Copy to .env and update values

# API server port
PORT=3000

# PostgreSQL connection string (required). For local dev, run a Postgres and point here;
# in Docker, compose injects this automatically (see docker-compose.yml).
DATABASE_URL=postgres://mission:mission@localhost:5432/mission_designer

# Comma-separated allowed CORS origins (production)
# ALLOWED_ORIGINS=https://app.trajectory.example.com

# Behind a reverse proxy: its IPs or CIDR ranges, comma-separated, so rate limits key on
# each user's IP from X-Forwarded-For. Unset = trust no proxy (the connection's own IP).
# TRUSTED_PROXIES=10.0.0.0/8

# Auth session signing secret (REQUIRED in production)
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-in-production
