{
  "name": "mission-designer",
  "version": "2.1.1",
  "description": "Mission Designer - Visual workflow specification editor",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix ../MissionFormKit run build:tokens && npm -w @mission/tokens run build && npm run build:help && vite",
    "build": "npm --prefix ../MissionFormKit run build:tokens && npm -w @mission/tokens run build && npm run build:help && tsc -b && vite build",
    "build:help": "node scripts/build-help.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:run:perf": "vitest run --config vitest.perf.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "server": "node --watch --import tsx src/server/index.ts",
    "dev:all": "npm --prefix ../MissionFormKit run build:tokens && npm -w @mission/tokens run build && npm run build:help && node scripts/dev-start.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lint": "^6.9.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hono/node-server": "^2.1.5",
    "@hookform/resolvers": "^5.2.2",
    "@mission/form-renderer": "file:../MissionFormKit/packages/form-renderer",
    "@mission/form-schema": "file:../MissionFormKit/packages/form-schema",
    "@mission/form-tokens": "file:../MissionFormKit/packages/form-tokens",
    "@mission/tokens": "*",
    "@mission/ui": "*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-router": "^1.157.16",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@uiw/react-codemirror": "^4.25.4",
    "@xyflow/react": "^12.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-auth": "~1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dompurify": "^3.3.3",
    "drizzle-orm": "^0.45.1",
    "fast-xml-parser": "^5.9.3",
    "file-saver": "^2.0.5",
    "hono": "^4.11.7",
    "html-to-image": "^1.11.11",
    "idb-keyval": "^6.2.2",
    "immer": "^11.1.4",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "pg": "^8.22.0",
    "react": "^19.2.4",
    "react-colorful": "^5.6.1",
    "react-device-mockup": "^1.0.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-rnd": "^10.5.2",
    "react-zoom-pan-pinch": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6",
    "zundo": "^2.3.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.157.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.53",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.1.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "marked": "^18.0.4",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md}": [
      "prettier --write"
    ]
  }
}
