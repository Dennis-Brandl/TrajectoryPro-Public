      "description": "ChildWorkflowExport (v7.0+): a child workflow with explicit parent linkage and required lifecycle fields.",
      "properties": {
        "parentChildSpecId": {
          "type": ["string", "null"],
          "description": "OID of the parent child spec in the same 'children' tree. null = direct child of the root workflow. When non-null, value equals the 'oid' of the parent ChildWorkflowExport one level up."
        },
        "version": {
          "type": "string",
          "description": "Semver version string for this child spec. REQUIRED on child exports (unlike optional on root)."
        },
        "state": {
          "type": "string",
          "description": "Lifecycle state (Draft | InTest | InReview | Approved | Effective | Superseded | Obsolete). REQUIRED on child exports."
        },
        "display_style": {
