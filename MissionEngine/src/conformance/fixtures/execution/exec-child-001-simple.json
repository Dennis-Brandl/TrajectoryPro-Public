{
  "test_id": "exec-child-001",
  "name": "Simple child workflow auto-completes",
  "category": "execution",
  "tags": ["child-workflow"],
  "workflow": {
    "local_id": "parent-wf", "oid": "parent-wf", "version": "1.0.0", "last_modified_date": "2026-03-15",
    "steps": [
      { "local_id": "start", "oid": "start", "version": "1.0.0", "last_modified_date": "2026-03-15", "step_type": "START" },
      { "local_id": "child-wf", "oid": "proxy", "version": "1.0.0", "last_modified_date": "2026-03-15", "step_type": "WORKFLOW PROXY" },
      { "local_id": "end", "oid": "end", "version": "1.0.0", "last_modified_date": "2026-03-15", "step_type": "END" }
    ],
    "connections": [
      { "from_step_id": "start", "to_step_id": "proxy" },
      { "from_step_id": "proxy", "to_step_id": "end" }
    ],
    "children": [
      {
        "local_id": "child-wf", "oid": "child-wf", "version": "1.0.0", "last_modified_date": "2026-03-15",
        "parentChildSpecId": null,
        "state": "Effective",
        "steps": [
          { "local_id": "c-start", "oid": "c-start", "version": "1.0.0", "last_modified_date": "2026-03-15", "step_type": "START" },
          { "local_id": "c-end", "oid": "c-end", "version": "1.0.0", "last_modified_date": "2026-03-15", "step_type": "END" }
        ],
        "connections": [
          { "from_step_id": "c-start", "to_step_id": "c-end" }
        ]
      }
    ]
  },
  "expected": {
    "valid": true,
    "workflow_state": "COMPLETED",
    "execution_trace": [
      { "step_oid": "start", "state": "COMPLETED", "order": 1 },
      { "step_oid": "proxy", "state": "EXECUTING", "order": 2 },
      { "step_oid": "proxy", "state": "COMPLETED", "order": 3 },
      { "step_oid": "end", "state": "COMPLETED", "order": 4 }
    ]
  }
}
