{
  "test_id": "exec-child-002",
  "name": "Child workflow passes parameters between parent and child",
  "category": "execution",
  "tags": ["child-workflow", "parameters"],
  "workflow": {
    "local_id": "parent-wf", "oid": "parent-wf", "version": "1.0.0", "last_modified_date": "2026-03-15",
    "value_property_specifications": [
      { "name": "Input", "entries": [{ "name": "Value", "value": "hello-from-parent" }] }
    ],
    "steps": [
      { "local_id": "start", "oid": "start", "version": "1.0.0", "last_modified_date": "2026-03-15", "step_type": "START" },
      {
        "local_id": "child-wf", "oid": "proxy", "version": "1.0.0", "last_modified_date": "2026-03-15",
        "step_type": "WORKFLOW PROXY",
        "input_parameter_specifications": [
          { "id": "msg", "oid": "ip1", "default_value": "Input.Value", "value_type": "property" }
        ],
        "output_parameter_specifications": [
          { "id": "result", "oid": "op1", "target": "Output.Result" }
        ]
      },
      { "local_id": "end", "oid": "end", "version": "1.0.0", "last_modified_date": "2026-03-15", "step_type": "END" }
    ],
    "connections": [
      { "from_step_id": "start", "to_step_id": "proxy" },
      { "from_step_id": "proxy", "to_step_id": "end" }
    ],
    "children": [
      {
        "local_id": "child-wf", "oid": "child-wf", "version": "1.0.0", "last_modified_date": "2026-03-15",
        "parentChildSpecId": null,
        "state": "Effective",
        "starting_parameter_specifications": [
          { "id": "msg", "oid": "sp1", "default_value": "" }
        ],
        "output_parameter_specifications": [
          { "id": "result", "oid": "cop1", "target": "result" }
        ],
        "steps": [
          { "local_id": "c-start", "oid": "c-start", "version": "1.0.0", "last_modified_date": "2026-03-15", "step_type": "START" },
          {
            "local_id": "c-script", "oid": "c-script", "version": "1.0.0", "last_modified_date": "2026-03-15",
            "step_type": "SCRIPT",
            "script_config": { "language": "javascript", "source": "output.result = msg + '-processed';" },
            "input_parameter_specifications": [
              { "id": "msg", "oid": "cip1", "default_value": "msg", "value_type": "property" }
            ],
            "output_parameter_specifications": [
              { "id": "result", "oid": "cop1", "target": "result" }
            ]
          },
          { "local_id": "c-end", "oid": "c-end", "version": "1.0.0", "last_modified_date": "2026-03-15", "step_type": "END" }
        ],
        "connections": [
          { "from_step_id": "c-start", "to_step_id": "c-script" },
          { "from_step_id": "c-script", "to_step_id": "c-end" }
        ]
      }
    ]
  },
  "expected": {
    "valid": true,
    "workflow_state": "COMPLETED",
    "final_properties": {
      "Input.Value": "hello-from-parent",
      "Output.Result": "hello-from-parent-processed"
    }
  }
}
