{
  "test_id": "exec-linear-002",
  "name": "Linear flow with user interaction",
  "category": "execution",
  "tags": ["linear", "user-interaction"],
  "workflow": {
    "local_id": "wf-exec-002",
    "oid": "wf-exec-002-oid",
    "version": "1.0.0",
    "last_modified_date": "2026-03-04T00:00:00Z",
    "schemaVersion": "4.0",
    "steps": [
      {
        "local_id": "start",
        "oid": "step-start",
        "version": "1.0.0",
