        "step_type": "START",
        "position": { "x": 100, "y": 100 }
      },
      {
        "local_id": "ui",
        "oid": "step-ui",
        "version": "1.0.0",
        "last_modified_date": "2026-03-04T00:00:00Z",
        "step_type": "USER_INTERACTION",
        "position": { "x": 100, "y": 200 },
        "form_layout_config": [
          {
            "deviceType": "phone",
            "canvasWidth": 390,
            "canvasHeight": 844,
            "elements": [
              {
                "type": "textInput",
                "x": 10,
                "y": 10,
                "width": 370,
                "height": 50,
                "label": "Your Name",
                "placeholder": "Enter your name",
                "fieldName": "name",
                "required": true,
                "outputParameter": "UserResponse.Value"
              },
              {
                "type": "button",
                "x": 10,
                "y": 80,
                "width": 370,
                "height": 50,
                "label": "Submit",
                "outputValue": "done"
              }
            ]
          }
        ]
      },
      {
        "local_id": "end",
        "oid": "step-end",
        "version": "1.0.0",
        "last_modified_date": "2026-03-04T00:00:00Z",
        "step_type": "END",
        "position": { "x": 100, "y": 300 }
      }
    ],
    "connections": [
      {
        "from_step_id": "step-start",
        "to_step_id": "step-ui"
      },
      {
        "from_step_id": "step-ui",
        "to_step_id": "step-end"
      }
    ]
  },
  "user_actions": [
    {
      "step_oid": "step-ui",
      "action": "submit",
      "form_values": { "name": "Alice" }
