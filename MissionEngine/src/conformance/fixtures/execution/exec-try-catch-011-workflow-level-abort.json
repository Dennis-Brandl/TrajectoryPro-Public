{
  "test_id": "exec-try-catch-011",
  "name": "Uncaught ABORT falls back to the workflow-level TRY handler (ABANDON)",
  "category": "execution",
  "tags": ["try-catch", "workflow-level"],
  "workflow": {
    "local_id": "wf", "oid": "wf-1", "version": "1.0.0", "last_modified_date": "2026-08-22T12:00:00.000Z",
    "schemaVersion": "4.0",
    "environment_specifications": [
      { "local_id": "env", "oid": "env-1", "version": "1.0.0", "last_modified_date": "2026-08-22T12:00:00.000Z",
        "included_actions": [{ "action_oid": "act-1", "action_name": "DoThing", "action_library": "lib-1" }] }
    ],
    "try_specifications": [{ "mode": "ABORT", "catch_id": "WF" }],
    "steps": [
      { "local_id": "Start", "oid": "s1", "version": "1.0.0", "last_modified_date": "2026-08-22T12:00:00.000Z", "step_type": "START" },
      { "local_id": "Action", "oid": "s2", "version": "1.0.0", "last_modified_date": "2026-08-22T12:00:00.000Z", "step_type": "ACTION PROXY", "action_proxy_config": { "action_oid": "act-1", "environment_oid": "env-1" } },
      { "local_id": "End", "oid": "s3", "version": "1.0.0", "last_modified_date": "2026-08-22T12:00:00.000Z", "step_type": "END" },
      { "local_id": "WfCatch", "oid": "c1", "version": "1.0.0", "last_modified_date": "2026-08-22T12:00:00.000Z", "step_type": "CATCH", "catch_id": "WF" },
      { "local_id": "Ret", "oid": "r1", "version": "1.0.0", "last_modified_date": "2026-08-22T12:00:00.000Z", "step_type": "RETURN", "return_config": { "command": "ABANDON" } }
    ],
    "connections": [
      { "from_step_id": "s1", "to_step_id": "s2" },
      { "from_step_id": "s2", "to_step_id": "s3" },
      { "from_step_id": "c1", "to_step_id": "r1" }
    ]
  },
  "user_actions": [{ "step_oid": "s2", "action": "fail", "failure_mode": "ABORT", "error": "boom" }],
  "expected": { "valid": true, "workflow_state": "ABORTED" }
