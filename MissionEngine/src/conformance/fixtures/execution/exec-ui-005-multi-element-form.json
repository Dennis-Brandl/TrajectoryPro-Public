{
  "test_id": "exec-ui-005",
  "name": "Multi-element form captures all interactive values",
  "category": "execution",
  "tags": ["user-interaction", "multi-element", "output-capture"],
  "workflow": {
    "local_id": "wf-ui-005",
    "oid": "wf-ui-005-oid",
    "version": "1.0.0",
    "last_modified_date": "2026-03-04T00:00:00Z",
    "schemaVersion": "4.0",
    "value_property_specifications": [
      {
        "name": "Survey",
        "entries": [
          { "name": "Name", "value": "" },
          { "name": "Interests", "value": "" }
        ]
      }
    ],
    "steps": [
      {
        "local_id": "start",
        "oid": "step-start",
        "version": "1.0.0",
        "last_modified_date": "2026-03-04T00:00:00Z",
        "step_type": "START",
        "position": { "x": 100, "y": 100 }
      },
      {
        "local_id": "ui",
        "oid": "step-ui",
        "version": "1.0.0",
        "last_modified_date": "2026-03-04T00:00:00Z",
        "step_type": "USER_INTERACTION",
        "position": { "x": 100, "y": 200 },
        "form_layout_config": [
          {
            "deviceType": "phone",
            "canvasWidth": 390,
            "canvasHeight": 844,
            "elements": [
              {
                "type": "header",
                "x": 20,
                "y": 20,
                "width": 350,
                "height": 40,
                "content": { "content": "Survey Form", "plainText": "Survey Form" }
              },
              {
                "type": "text",
                "x": 20,
                "y": 70,
                "width": 350,
                "height": 30,
                "content": { "content": "Please fill in the details below.", "plainText": "Please fill in the details below." }
              },
              {
                "type": "textInput",
                "x": 20,
                "y": 110,
                "width": 350,
                "height": 50,
                "label": "Name",
                "fieldName": "name",
                "outputParameter": "Survey.Name"
              },
              {
                "type": "checkbox",
                "x": 20,
                "y": 180,
                "width": 350,
                "height": 100,
                "label": "Interests",
                "fieldName": "interests",
                "options": ["Sports", "Music", "Travel"],
                "outputParameter": "Survey.Interests"
              },
              {
                "type": "button",
                "x": 20,
                "y": 300,
                "width": 350,
                "height": 50,
                "label": "Submit",
                "outputValue": "done"
              }
            ]
          }
        ]
      },
      {
        "local_id": "end",
        "oid": "step-end",
        "version": "1.0.0",
        "last_modified_date": "2026-03-04T00:00:00Z",
        "step_type": "END",
        "position": { "x": 100, "y": 300 }
      }
    ],
    "connections": [
      {
        "from_step_id": "step-start",
        "to_step_id": "step-ui"
      },
      {
        "from_step_id": "step-ui",
        "to_step_id": "step-end"
      }
    ]
  },
  "user_actions": [
    {
      "step_oid": "step-ui",
      "action": "submit",
      "form_values": { "name": "Alice", "interests": ["Sports", "Travel"] }
    }
  ],
  "expected": {
    "valid": true,
    "execution_trace": [
      { "step_oid": "step-start", "state": "COMPLETED", "order": 1 },
      { "step_oid": "step-ui", "state": "EXECUTING", "order": 2 },
      { "step_oid": "step-ui", "state": "COMPLETED", "order": 3, "after_action": 0 },
      { "step_oid": "step-end", "state": "COMPLETED", "order": 4 }
    ],
    "final_properties": {
      "Survey.Name": "Alice",
      "Survey.Interests": "[\"Sports\",\"Travel\"]"
    },
    "workflow_state": "COMPLETED"
  }
}
