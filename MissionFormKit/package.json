{
  "name": "mission-form-kit",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:tokens": "node packages/form-tokens/scripts/build.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "demo": "vite --config packages/form-renderer/demo/vite.config.ts",
    "shell": "vite --config apps/form-shell/vite.config.ts",
    "golden": "vite --config packages/form-renderer/golden/vite.config.ts",
    "test:e2e": "playwright test",
    "build:shell": "vite build --config apps/form-shell/vite.config.ts",
    "preview:shell": "vite preview --config apps/form-shell/vite.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  }
}
