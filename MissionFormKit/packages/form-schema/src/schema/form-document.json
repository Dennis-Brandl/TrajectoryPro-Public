{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trajectorypro.io/schemas/form-document.json",
  "title": "Trajectory Form Document v2",
  "type": "object",
  "required": ["version", "sections"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "sections": { "type": "array", "items": { "$ref": "#/definitions/section" } }
  },
  "definitions": {
    "oid": { "type": "string", "minLength": 1 },
    "gridSpan": { "type": "integer", "minimum": 1, "maximum": 12 },
    "spaceToken": { "enum": ["none", "xs", "sm", "md", "lg", "xl"] },
    "typeToken": { "enum": ["xs", "sm", "md", "lg", "xl", "2xl", "3xl"] },
    "sizeAt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tablet": { "$ref": "#/definitions/typeToken" },
        "phone": { "$ref": "#/definitions/typeToken" }
      }
    },
    "pbSpan": {
      "type": "object",
      "required": ["base"],
      "additionalProperties": false,
      "properties": {
        "base": { "$ref": "#/definitions/gridSpan" },
        "tablet": { "$ref": "#/definitions/gridSpan" },
        "phone": { "$ref": "#/definitions/gridSpan" }
      }
    },
    "pbOrder": {
      "type": "object",
      "required": ["base"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "integer", "minimum": 1, "maximum": 12 },
        "tablet": { "type": "integer", "minimum": 1, "maximum": 12 },
        "phone": { "type": "integer", "minimum": 1, "maximum": 12 }
      }
    },
    "pbVisible": {
      "type": "object",
      "required": ["base"],
      "additionalProperties": false,
      "properties": {
        "base": { "type": "boolean" },
        "tablet": { "type": "boolean" },
        "phone": { "type": "boolean" }
      }
    },
    "blockLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "span": { "$ref": "#/definitions/pbSpan" },
        "order": { "$ref": "#/definitions/pbOrder" },
        "visible": { "$ref": "#/definitions/pbVisible" },
        "minHeight": {
          "oneOf": [
            { "$ref": "#/definitions/spaceToken" },
            {
              "type": "object",
              "required": ["rem"],
              "additionalProperties": false,
              "properties": { "rem": { "type": "number", "exclusiveMinimum": 0 } }
            }
          ]
        },
        "maxWidth": {
          "oneOf": [
            {
              "type": "object",
              "required": ["ch"],
              "additionalProperties": false,
              "properties": { "ch": { "type": "number", "exclusiveMinimum": 0 } }
            },
            {
              "type": "object",
              "required": ["rem"],
              "additionalProperties": false,
              "properties": { "rem": { "type": "number", "exclusiveMinimum": 0 } }
            }
          ]
        },
        "aspectRatio": { "type": "string", "pattern": "^[1-9][0-9]*\\s*/\\s*[1-9][0-9]*$" },
        "align": { "enum": ["start", "center", "end"] }
      }
    },
    "defaultSource": {
      "type": "object",
      "required": ["mode", "value"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["static", "property", "input"] },
        "value": { "type": "string" }
      }
    },
    "optionEntry": {
      "type": "object",
      "required": ["label", "value"],
      "additionalProperties": false,
      "properties": { "label": { "type": "string" }, "value": { "type": "string" } }
    },
    "listSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": { "mode": { "const": "static" } }
        },
        {
          "type": "object",
          "required": ["mode", "value"],
          "additionalProperties": false,
          "properties": { "mode": { "const": "input" }, "value": { "type": "string" } }
        }
      ]
    },
    "textAlign": { "enum": ["left", "center", "right"] },
    "fontWeight": { "enum": ["normal", "bold"] },
    "textBlock": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "type": { "const": "text" },
        "layout": { "$ref": "#/definitions/blockLayout" },
        "content": { "type": "string" },
        "size": { "$ref": "#/definitions/typeToken" },
        "sizeAt": { "$ref": "#/definitions/sizeAt" },
        "fontWeight": { "$ref": "#/definitions/fontWeight" },
        "color": { "type": "string" },
        "align": { "$ref": "#/definitions/textAlign" }
      }
    },
    "headerBlock": {
      "type": "object",
      "required": ["id", "type", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "type": { "const": "header" },
        "layout": { "$ref": "#/definitions/blockLayout" },
        "content": { "type": "string" },
        "size": { "$ref": "#/definitions/typeToken" },
        "sizeAt": { "$ref": "#/definitions/sizeAt" },
        "fontWeight": { "$ref": "#/definitions/fontWeight" },
        "color": { "type": "string" },
        "align": { "$ref": "#/definitions/textAlign" }
      }
    },
    "textInputBlock": {
      "type": "object",
      "required": ["id", "type", "fieldName"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "type": { "const": "textInput" },
        "layout": { "$ref": "#/definitions/blockLayout" },
        "fieldName": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean" },
        "inputMode": { "enum": ["text", "number", "phone", "password", "dropdown", "combobox"] },
        "listItems": { "type": "array", "items": { "$ref": "#/definitions/optionEntry" } },
        "listSource": { "$ref": "#/definitions/listSource" },
        "outputParameter": { "type": "string" },
        "defaultSource": { "$ref": "#/definitions/defaultSource" },
        "placeholderSource": { "$ref": "#/definitions/defaultSource" },
        "size": { "$ref": "#/definitions/typeToken" },
        "sizeAt": { "$ref": "#/definitions/sizeAt" }
      }
    },
    "textareaBlock": {
      "type": "object",
      "required": ["id", "type", "fieldName"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "type": { "const": "textarea" },
        "layout": { "$ref": "#/definitions/blockLayout" },
        "fieldName": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean" },
        "rows": { "type": "integer", "minimum": 1 },
        "outputParameter": { "type": "string" },
        "defaultSource": { "$ref": "#/definitions/defaultSource" },
        "placeholderSource": { "$ref": "#/definitions/defaultSource" },
        "size": { "$ref": "#/definitions/typeToken" },
        "sizeAt": { "$ref": "#/definitions/sizeAt" }
      }
    },
    "checkboxBlock": {
      "type": "object",
      "required": ["id", "type", "fieldName", "options"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "type": { "const": "checkbox" },
        "layout": { "$ref": "#/definitions/blockLayout" },
        "fieldName": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "$ref": "#/definitions/optionEntry" } },
        "label": { "type": "string" },
        "required": { "type": "boolean" },
        "listSource": { "$ref": "#/definitions/listSource" },
        "outputParameter": { "type": "string" },
        "size": { "$ref": "#/definitions/typeToken" },
        "sizeAt": { "$ref": "#/definitions/sizeAt" }
      }
    },
    "radioBlock": {
      "type": "object",
      "required": ["id", "type", "fieldName", "options"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "type": { "const": "radio" },
        "layout": { "$ref": "#/definitions/blockLayout" },
        "fieldName": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "$ref": "#/definitions/optionEntry" } },
        "label": { "type": "string" },
        "required": { "type": "boolean" },
        "listSource": { "$ref": "#/definitions/listSource" },
        "outputParameter": { "type": "string" },
        "size": { "$ref": "#/definitions/typeToken" },
        "sizeAt": { "$ref": "#/definitions/sizeAt" }
      }
    },
    "imageBlock": {
      "type": "object",
      "required": ["id", "type", "src", "layout"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "type": { "const": "image" },
        "layout": {
          "allOf": [{ "$ref": "#/definitions/blockLayout" }, { "type": "object", "required": ["aspectRatio"] }]
        },
        "src": { "type": "string", "minLength": 1 },
        "imageOid": { "type": "string" },
        "objectFit": { "enum": ["contain", "cover", "fill"] },
        "scalePercent": { "type": "integer", "minimum": 10, "maximum": 300 }
      }
    },
    "videoBlock": {
      "type": "object",
      "required": ["id", "type", "src"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "type": { "const": "video" },
        "layout": { "$ref": "#/definitions/blockLayout" },
        "src": { "type": "string", "minLength": 1 },
        "posterUrl": { "type": "string" }
      }
    },
    "dividerBlock": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "type": { "const": "divider" },
        "layout": { "$ref": "#/definitions/blockLayout" },
        "weight": { "enum": ["hairline", "thick"] },
        "color": { "type": "string" }
      }
    },
    "timerBlock": {
      "type": "object",
      "required": ["id", "type", "label", "fieldName", "durationSeconds", "direction"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "type": { "const": "timer" },
        "layout": { "$ref": "#/definitions/blockLayout" },
        "label": { "type": "string" },
        "fieldName": { "type": "string", "minLength": 1 },
        "durationSeconds": { "type": "integer", "minimum": 1 },
        "direction": { "enum": ["countdown", "countup"] },
        "blockDone": { "type": "boolean" },
        "outputParameter": { "type": "string" },
        "defaultSource": { "$ref": "#/definitions/defaultSource" },
        "size": { "$ref": "#/definitions/typeToken" },
        "sizeAt": { "$ref": "#/definitions/sizeAt" }
      }
    },
    "buttonBlock": {
      "type": "object",
      "required": ["id", "type", "label", "outputValue"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "type": { "const": "button" },
        "layout": { "$ref": "#/definitions/blockLayout" },
        "label": { "type": "string" },
        "outputValue": { "type": "string", "minLength": 1 },
        "color": { "type": "string" },
        "emphasis": { "enum": ["primary", "secondary"] },
        "deletable": { "type": "boolean" },
        "job": { "enum": ["continue", "yes", "no"] },
        "size": { "$ref": "#/definitions/typeToken" },
        "sizeAt": { "$ref": "#/definitions/sizeAt" }
      }
    },
    "esignatureBlock": {
      "type": "object",
      "required": ["id", "type", "fieldName"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "type": { "const": "esignature" },
        "layout": { "$ref": "#/definitions/blockLayout" },
        "fieldName": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "meaning": { "type": "string" },
        "roleName": { "type": "string" },
        "requireDifferentUser": { "type": "boolean" },
        "outputParameter": { "type": "string" }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/definitions/textBlock" },
        { "$ref": "#/definitions/headerBlock" },
        { "$ref": "#/definitions/textInputBlock" },
        { "$ref": "#/definitions/textareaBlock" },
        { "$ref": "#/definitions/checkboxBlock" },
        { "$ref": "#/definitions/radioBlock" },
        { "$ref": "#/definitions/imageBlock" },
        { "$ref": "#/definitions/videoBlock" },
        { "$ref": "#/definitions/dividerBlock" },
        { "$ref": "#/definitions/timerBlock" },
        { "$ref": "#/definitions/buttonBlock" },
        { "$ref": "#/definitions/esignatureBlock" }
      ]
    },
    "row": {
      "type": "object",
      "required": ["id", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "gap": { "$ref": "#/definitions/spaceToken" },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/block" } }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "role", "rows"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/oid" },
        "role": { "enum": ["content", "footer"] },
        "rows": { "type": "array", "items": { "$ref": "#/definitions/row" } }
      }
    }
  }
}
