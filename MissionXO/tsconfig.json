{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../MissionCommander/src/*"],
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "vitest.setup.ts", "vitest.config.ts", "vite.config.ts"],
  "exclude": ["../MissionCommander/src/server"]
}
